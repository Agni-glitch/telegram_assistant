# --- Required ---
BOT_TOKEN=
YOUR_USER_ID=

# Random string (letters, digits, _ and - only). Secures the webhook and the /setup page.
WEBHOOK_SECRET=

# --- About you ---
OWNER_NAME=Agni Roybar
# Facts the AI may share with people (work, typical response time, links...)
OWNER_ABOUT=
# e.g. Asia/Kolkata
TIMEZONE=UTC
# ai | away | available  (used until you pick one with /ai, /away, /available)
DEFAULT_MODE=ai

# --- AI models: comma-separated provider:model, tried in order ---
AI_MODELS=anthropic:claude-opus-5-5
# Optional: different models for your own chat with the bot (defaults to AI_MODELS)
OWNER_AI_MODELS=

# API keys: only for the providers you use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
# Any other OpenAI-compatible provider, e.g. AI_MODELS=myprov:some-model
# MYPROV_BASE_URL=https://example.com/v1
# MYPROV_API_KEY=

# --- Optional overrides ---
# AWAY_MESSAGE=
# AVAILABLE_MESSAGE=
# FAQ_TEXT=
# CONTACT_TEXT=
# AI_TIMEOUT=25
# ANTHROPIC_EFFORT=low
# ANTHROPIC_MAX_TOKENS=4000
